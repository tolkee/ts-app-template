{
  "name": "@todo/backend",
  "private": true,
  "imports": {
    "#features/*": "./src/features/*/index.ts",
    "#lib/*": "./src/lib/*.ts"
  },
  "exports": {
    "./api-type": {
      "types": "./src/api/index.ts"
    }
  },
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "start": "bun run db:migrate && bun run src/index.ts",
    "typecheck": "bun tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "infra:up": "docker compose -p todo up",
    "infra:up:d": "docker compose -p todo up -d",
    "infra:down": "docker compose -p todo down",
    "infra:logs": "docker compose -p todo logs"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.6.25",
    "@todo/common": "workspace:*",
    "better-auth": "^1.6.25",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.33",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@todo/ts-config": "workspace:*",
    "@types/bun": "latest",
    "drizzle-kit": "^0.31.10",
    "postgres": "^3.4.9"
  }
}
